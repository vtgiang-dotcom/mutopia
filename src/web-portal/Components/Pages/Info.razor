@page "/info"

<PageTitle>Info — MU Online</PageTitle>

<section class="py-16">
    <div class="container-page max-w-3xl mx-auto">
        <h1 class="font-display-hero text-secondary-fixed uppercase tracking-wider mb-8">Server Information</h1>

        <div class="space-y-6">
            <div class="panel-metallic p-6">
                <h2 class="font-headline-md text-secondary-fixed mb-3">Rates</h2>
                <table class="rank-table">
                    <tbody>
                        <tr><td>Experience</td><td class="text-secondary-fixed">x10000</td></tr>
                        <tr><td>Master Experience</td><td class="text-secondary-fixed">x10000</td></tr>
                        <tr><td>Zen Drop</td><td class="text-secondary-fixed">x7</td></tr>
                        <tr><td>Item Drop</td><td class="text-secondary-fixed">x5</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="panel-metallic p-6">
                <h2 class="font-headline-md text-secondary-fixed mb-3">Getting Started</h2>
                <ol class="list-decimal list-inside text-on-surface-variant space-y-2">
                    <li>Download the client and extract it.</li>
                    <li>Register an account on this website.</li>
                    <li>Launch Main.exe and log in with your credentials.</li>
                    <li>Choose your class and begin your legend.</li>
                </ol>
            </div>

            <div class="panel-metallic p-6">
                <h2 class="font-headline-md text-secondary-fixed mb-3">Support</h2>
                <p class="text-on-surface-variant">Need help? Reach out to the community or contact a game master in-game.</p>
            </div>
        </div>
    </div>
</section>
