@page "/register"

<PageTitle>Register — MU Online</PageTitle>

<section class="py-16">
    <div class="container-page max-w-md mx-auto">
        <h1 class="font-headline-lg text-secondary-fixed uppercase tracking-wider mb-8 text-center">Create Account</h1>

        <div class="panel-metallic p-8">
            <form action="/api/auth/register" method="post">
                <div class="space-y-4">
                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <div class="p-4 rounded bg-red-950/80 border border-red-500 text-red-300 text-sm font-medium mb-4">
                            ⚠️ @Error
                        </div>
                    }

                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant block mb-1">Username</label>
                        <input type="text" name="loginName" class="input-recessed w-full" placeholder="4-10 characters" minlength="4" maxlength="10" required autofocus />
                    </div>
                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant block mb-1">Email</label>
                        <input type="email" name="email" class="input-recessed w-full" placeholder="you@example.com" required />
                    </div>
                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant block mb-1">Password</label>
                        <input type="password" name="password" class="input-recessed w-full" placeholder="8-20 characters" minlength="8" maxlength="20" required />
                    </div>
                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant block mb-1">Repeat Password</label>
                        <input type="password" name="repeatPassword" class="input-recessed w-full" placeholder="Repeat Password" minlength="8" maxlength="20" required />
                    </div>

                    <button type="submit" class="btn-ornate w-full justify-center py-3 mt-2">Register</button>
                </div>
            </form>
        </div>

        <p class="text-center mt-6 text-on-surface-variant">
            Already have an account? <a href="/login" class="text-secondary-fixed">Sign In</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
