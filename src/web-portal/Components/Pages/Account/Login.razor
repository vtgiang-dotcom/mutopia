@page "/login"

<PageTitle>Sign In — MU Online</PageTitle>

<section class="py-16">
    <div class="container-page max-w-md mx-auto">
        <h1 class="font-headline-lg text-secondary-fixed uppercase tracking-wider mb-8 text-center">Sign In</h1>

        <div class="panel-metallic p-8">
            <form action="/api/auth/login" method="post">
                <div class="space-y-4">
                    @if (Registered == "1" || Registered == "true")
                    {
                        <div class="p-4 rounded bg-emerald-950/80 border border-emerald-500 text-emerald-300 text-sm font-medium mb-4">
                            ✅ Đăng ký tài khoản thành công! Vui lòng nhập mật khẩu để đăng nhập.
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <div class="p-4 rounded bg-red-950/80 border border-red-500 text-red-300 text-sm font-medium mb-4">
                            ⚠️ @Error
                        </div>
                    }

                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant block mb-1">Username</label>
                        <input type="text" name="loginName" value="@Username" class="input-recessed w-full" placeholder="Username" required autofocus />
                    </div>
                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant block mb-1">Password</label>
                        <input type="password" name="password" class="input-recessed w-full" placeholder="Password" required />
                    </div>

                    <button type="submit" class="btn-ornate w-full justify-center py-3 mt-2">Sign In</button>
                </div>
            </form>
        </div>

        <p class="text-center mt-6 text-on-surface-variant">
            No account? <a href="/register" class="text-secondary-fixed">Register</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    public string? Registered { get; set; }

    [SupplyParameterFromQuery(Name = "username")]
    public string? Username { get; set; }
}
