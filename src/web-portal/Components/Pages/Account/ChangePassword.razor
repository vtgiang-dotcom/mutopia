@page "/account/changepassword"
@rendermode InteractiveServer
@attribute [Authorize]
@inject AccountService AccountService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Change Password — MU Online</PageTitle>

<section class="py-16">
    <div class="container-page max-w-md mx-auto">
        <h1 class="font-headline-lg text-secondary-fixed uppercase tracking-wider mb-8 text-center">Change Password</h1>

        <div class="panel-metallic p-8">
            <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="changepassword">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant">Old Password</label>
                        <InputText type="password" @bind-Value="_model.OldPassword" class="input-recessed" />
                    </div>
                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant">New Password</label>
                        <InputText type="password" @bind-Value="_model.NewPassword" class="input-recessed" />
                    </div>
                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant">Repeat New Password</label>
                        <InputText type="password" @bind-Value="_model.RepeatPassword" class="input-recessed" />
                    </div>

                    @if (!string.IsNullOrEmpty(_message))
                    {
                        <div class="@(_isError ? "alert-error" : "alert-success")">@_message</div>
                    }

                    <button type="submit" class="btn-ornate w-full justify-center py-3">Change Password</button>
                </div>
            </EditForm>
        </div>
    </div>
</section>

@code {
    private ChangePasswordModel _model = new();
    private string? _message;
    private bool _isError;
    private Guid _accountId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        Guid.TryParse(idClaim, out _accountId);
    }

    private async Task HandleSubmit()
    {
        _message = null;
        var error = await AccountService.ChangePasswordAsync(_accountId, _model.OldPassword, _model.NewPassword, _model.RepeatPassword);
        if (error is not null)
        {
            _message = error;
            _isError = true;
            return;
        }

        _message = "Password changed successfully.";
        _isError = false;
        _model = new ChangePasswordModel();
    }

    private class ChangePasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Old password is required.")]
        public string OldPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "New password is required.")]
        [System.ComponentModel.DataAnnotations.StringLength(20, MinimumLength = 8, ErrorMessage = "Password must be 8-20 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your new password.")]
        public string RepeatPassword { get; set; } = string.Empty;
    }
}
