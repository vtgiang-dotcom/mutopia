@page "/download"

<PageTitle>Download — MU Online</PageTitle>

<section class="py-16">
    <div class="container-page max-w-3xl mx-auto text-center">
        <h1 class="font-display-hero text-secondary-fixed uppercase tracking-wider mb-4">Download Client</h1>
        <p class="font-body-lg text-on-surface-variant mb-8">Grab the client and step into a world forged in darkness.</p>

        <div class="panel-metallic p-8 mb-6">
            <span class="material-symbols-outlined text-secondary-fixed text-6xl mb-4">download</span>
            <h2 class="font-headline-md text-secondary-fixed mb-2">MU Online Client</h2>
            <p class="text-on-surface-variant text-sm mb-6">Full game client. Season 6 Episode 3.</p>
            <a href="#" class="btn-ornate px-8 py-3 text-lg uppercase tracking-widest">
                <span class="material-symbols-outlined">cloud_download</span>
                Download Now
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
            <div class="card-metallic p-6">
                <h3 class="font-headline-sm text-secondary-fixed mb-2 uppercase">1. Download</h3>
                <p class="text-on-surface-variant text-sm">Get the client archive and extract it to a folder of your choice.</p>
            </div>
            <div class="card-metallic p-6">
                <h3 class="font-headline-sm text-secondary-fixed mb-2 uppercase">2. Register</h3>
                <p class="text-on-surface-variant text-sm">Create an account to save your progress and heroes.</p>
            </div>
            <div class="card-metallic p-6">
                <h3 class="font-headline-sm text-secondary-fixed mb-2 uppercase">3. Play</h3>
                <p class="text-on-surface-variant text-sm">Launch Main.exe and enter the realm.</p>
            </div>
        </div>
    </div>
</section>
