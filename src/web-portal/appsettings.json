{
  "ConnectionStrings": {
    "OpenMu": "Host=${POSTGRES_HOST:-localhost};Port=${POSTGRES_PORT:-5438};Database=${POSTGRES_DB:-openmu};Username=${POSTGRES_USER:-postgres};Password=${POSTGRES_PASSWORD}",
    "S16MySQL": "Server=${MYSQL_HOST:-localhost};Port=${MYSQL_PORT:-3307};Database=${MYSQL_DB:-database_login};User ID=${MYSQL_USER:-root};Password=${MYSQL_PASSWORD};AllowZeroDateTime=True;"
  },
  "GameserverUrl": "${GAMESERVER_URL:-http://localhost:8080}",
  "PlayerWebUrl": "${PLAYERWEB_URL:-http://localhost:3007}",
  "GameSettings": {
    "ZenToReset": "5000000",
    "LvlToReset": 400,
    "MaxReset": 100,
    "ZenToPkClear": "3000000",
    "ZenToResetStats": "2000000",
    "ZenToRename": "5000000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "${ALLOWED_HOSTS:-localhost;*.mutopia.local}"
}
