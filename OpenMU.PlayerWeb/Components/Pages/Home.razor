@page "/"
@inject NewsService NewsService
@inject ServerStatusService ServerStatus

<PageTitle>MU Online — Forge Your Destiny</PageTitle>

<!-- Hero Section -->
<section class="relative min-h-[600px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-60 z-0 mix-blend-luminosity"
         style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCjTC90avTjg8wQyxopU0gufnPEzZeVUfD435j50D7FjUmuUkUNa1PIoxTfMFypm8E2dEX1iDAFMLomq9jIWNtSywxoGelr5_zmRLTNDawxYdtklzyrjnb0jGV6WAEEu4fcB9wFcNW2doTCW1zEHNcimeV3fotPuHd21JFFCmk8NKwL953jUW-PXrYWt5-zavwnUjeO93oRkYRB6cXF4qKpK4xnS0Ox_6_dvKeGEksDCsFc5Wtz0RZJrA')"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent z-10"></div>
    <div class="relative z-20 container-page text-center">
        <h1 class="font-display-hero text-secondary-fixed mb-4 uppercase tracking-wider" style="text-shadow: 0 5px 15px rgba(0,0,0,0.9);">
            Forge Your Destiny
        </h1>
        <p class="font-body-lg text-on-background mb-8 max-w-2xl mx-auto">
            Enter a dark and perilous world where legends are born in blood and fire. Choose your class, master ancient magic, and conquer the darkness.
        </p>
        <a href="/register" class="btn-ornate px-8 py-4 text-lg uppercase tracking-widest">
            <span class="material-symbols-outlined">local_fire_department</span>
            Play Now Free
        </a>
    </div>
</section>

<div class="container-page py-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Left: News -->
    <div class="lg:col-span-8 space-y-8">
        <h2 class="section-title">
            <span class="material-symbols-outlined">newspaper</span>
            Latest Chronicles
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var news in _news)
            {
                <article class="card-metallic group p-4 flex flex-col relative overflow-hidden">
                    <div class="relative z-10 flex-grow">
                        <span class="badge mb-2">News</span>
                        <h3 class="font-headline-sm text-on-surface mb-2 mt-2 leading-tight">@news.Title</h3>
                        <p class="text-on-surface-variant text-sm line-clamp-3">@Truncate(news.Body, 140)</p>
                    </div>
                    <div class="mt-4 pt-4 border-t border-outline-variant/50 relative z-10">
                        <div class="flex justify-between items-center">
                            <a href="/news/@news.Id" class="text-secondary-fixed hover:text-[#FFD700] font-label-caps uppercase flex items-center gap-1">
                                Read More <span class="material-symbols-outlined text-sm">arrow_forward</span>
                            </a>
                            <span class="text-on-surface-variant/70 text-xs">@news.CreationDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                </article>
            }
            @if (_news.Count == 0)
            {
                <p class="text-on-surface-variant col-span-2">No news yet. Check back soon.</p>
            }
        </div>
    </div>

    <!-- Right: Sidebar -->
    <aside class="lg:col-span-4 space-y-6">
        <div class="panel-metallic p-6 relative overflow-hidden">
            <h3 class="font-headline-sm text-secondary-fixed mb-6 uppercase tracking-wider border-b border-primary-container/50 pb-2">
                Realm Status
            </h3>
            <div class="flex items-center justify-between bg-surface-container-highest p-3 border border-outline-variant">
                <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-emerald-500" style="box-shadow: 0 0 8px #10b981;"></div>
                    <div class="font-label-caps text-on-surface uppercase">Main Realm</div>
                </div>
                <div class="font-stats-ui text-secondary-fixed">
                    @if (_onlineCount >= 0)
                    {
                        @_onlineCount <text> <span class="text-on-surface-variant text-xs">online</span></text>
                    }
                    else
                    {
                        <span class="text-on-surface-variant text-xs">offline</span>
                    }
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <a href="/download" class="panel-metallic p-4 flex flex-col items-center justify-center gap-2 hover:border-secondary-fixed-dim transition-colors group">
                <span class="material-symbols-outlined text-secondary-fixed group-hover:scale-110 transition-transform text-3xl">download</span>
                <span class="font-label-caps uppercase text-on-surface">Download Client</span>
            </a>
            <a href="/rankings" class="panel-metallic p-4 flex flex-col items-center justify-center gap-2 hover:border-secondary-fixed-dim transition-colors group">
                <span class="material-symbols-outlined text-secondary-fixed group-hover:scale-110 transition-transform text-3xl">military_tech</span>
                <span class="font-label-caps uppercase text-on-surface">Rankings</span>
            </a>
            <a href="/classes" class="panel-metallic p-4 flex flex-col items-center justify-center gap-2 hover:border-secondary-fixed-dim transition-colors group">
                <span class="material-symbols-outlined text-secondary-fixed group-hover:scale-110 transition-transform text-3xl">swords</span>
                <span class="font-label-caps uppercase text-on-surface">Classes</span>
            </a>
            <a href="/info" class="panel-metallic p-4 flex flex-col items-center justify-center gap-2 hover:border-secondary-fixed-dim transition-colors group">
                <span class="material-symbols-outlined text-secondary-fixed group-hover:scale-110 transition-transform text-3xl">support_agent</span>
                <span class="font-label-caps uppercase text-on-surface">Support</span>
            </a>
        </div>
    </aside>
</div>

@code {
    private List<NewsItem> _news = new();
    private int _onlineCount = -1;

    protected override async Task OnInitializedAsync()
    {
        _news = await NewsService.GetAllAsync(6);
        var players = await ServerStatus.GetOnlinePlayersAsync();
        _onlineCount = players?.Count ?? -1;
    }

    private static string Truncate(string text, int max)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= max)
        {
            return text;
        }

        return text[..max] + "...";
    }
}
