@page "/login"

<PageTitle>Sign In — MU Online</PageTitle>

<section class="py-16">
    <div class="container-page max-w-md mx-auto">
        <h1 class="font-headline-lg text-secondary-fixed uppercase tracking-wider mb-8 text-center">Sign In</h1>

        <div class="panel-metallic p-8">
            <form action="/api/auth/login" method="post">
                <div class="space-y-4">
                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant block mb-1">Username</label>
                        <input type="text" name="loginName" class="input-recessed w-full" required autofocus />
                    </div>
                    <div>
                        <label class="font-label-caps uppercase text-on-surface-variant block mb-1">Password</label>
                        <input type="password" name="password" class="input-recessed w-full" required />
                    </div>

                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <div class="alert-error">@Error</div>
                    }

                    <button type="submit" class="btn-ornate w-full justify-center py-3">Sign In</button>
                </div>
            </form>
        </div>

        <p class="text-center mt-6 text-on-surface-variant">
            No account? <a href="/register" class="text-secondary-fixed">Register</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
